{
  "name": "web-mock-studio",
  "version": "1.0.0",
  "description": "Zero-backend, offline-first API mock workbench: Service Worker interception, JSON Schema inference, semantic fake data, and cURL request runner in the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "zzoraemon043",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzoraemon043/web-mock-studio.git"
  },
  "keywords": [
    "mock",
    "api",
    "service-worker",
    "json-schema",
    "faker",
    "curl",
    "offline-first",
    "devtools"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
